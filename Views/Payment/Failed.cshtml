@{ ViewData["Title"] = "Payment failed"; }
<section class="card narrow center">
    <div class="badge bad">✕</div>
    <p class="kicker bad">Payment not completed</p>
    <h1>Payment <em>failed</em></h1>
    <p class="muted">Your transaction could not be completed. If any amount was debited, it will be refunded automatically by your bank within 5-7 working days.</p>
    <a class="btn block" href="/">Try again</a>
</section>
